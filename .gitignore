# Build artifacts
tmux/build/
tmux/build-darwin/
scripts/oom_set
*.o
*.lo
*.la
*.tmp

# Editor
*.swp
*.swo
# Python bytecode caches (test helpers)
**/__pycache__/
*.pyc
*~
.idea/
.vscode/

# Test logs
/tmp/__*.log
/tmp/.*tmux*

# Generated wrappers + shell-init (installed via setup.sh; never committed)
scripts/tmx
scripts/tmx-vm
scripts/tmx-shell-init.sh

# §11.4.30 + §11.4.77 — Go-built per-OS binary. Source under scripts/tmx-state/
# is tracked; the binary is rebuilt by setup.sh step 3d on each host.
scripts/tmx-state-bin

# §11.4.30 + §11.4.77 — Go-built tmx-orchestrator binary (Containers-submodule
# consumer). Source under scripts/tmx-orchestrator/ (go.mod, go.sum, main.go,
# README.md) is tracked; the binary is rebuilt via
# `go build -o ../tmx-orchestrator-bin .` on each host.
scripts/tmx-orchestrator-bin

# §11.4.30 + §11.4.77 — per-host LOCAL dependency tree (jemalloc etc.).
# Obtained/resolved git-ignored by scripts/obtain_local_deps.sh (the
# §11.4.77 regeneration mechanism, declared in .gitignore-meta/local_deps.yaml).
# Contains the resolved.env + any locally-built/extracted shared libraries +
# the tarball cache — all per-machine build derivatives, never versioned.
.local-deps/

# §11.4.78 CodeGraph — local SQLite knowledge graph (per-machine, regenerated via scripts/codegraph_reindex.sh per §11.4.77)
.codegraph/codegraph.db
.codegraph/codegraph.db-*
.codegraph/cache/
.codegraph/daemon.pid

# v1.0.16 PWU-Q3 testdata exports — golden snapshots ARE tracked (.md),
# their HTML/PDF/DOCX siblings are auto-generated transient outputs
# and should NOT be versioned (regenerated by sync_all_markdown_exports.sh).
cmd/workable-items/testdata/*.html
cmd/workable-items/testdata/*.pdf
cmd/workable-items/testdata/*.docx

# Meta-test mutation backups (left behind on abort-paths despite trap;
# safe to ignore — the harness cleans the real backup name pattern).
**/*.bak.meta
**/*.bak.v109.*

# Stray go-build root binary (when `go build` runs without -o flag in
# this module; the canonical output is cmd/workable-items/workable-items).
/workable-items
.codegraph/.dirty

# §11.4.30 + §11.4.77 — per-host regeneration stamps. The `.yaml`
# manifests under .gitignore-meta/ ARE tracked (they declare the
# regen mechanism per §11.4.77); the per-run timestamp markers
# under .regenerated/ are LOCAL runtime state and MUST NOT be
# versioned (they change on every setup.sh run, causing constant
# `M` in `git status`). The gates that consume them resolve from
# host state, not from git.
.gitignore-meta/.regenerated/

# Local-only Claude Code session/setting files (per-operator)
.claude/

# §11.4.95 — workable-items SQLite DB is TRACKED at docs/workable_items.db
# (NOT a build artefact — it IS the authoritative single-source-of-truth
# data per §11.4.93+§11.4.95). Sidecar WAL files ARE gitignored per
# §11.4.95 ("transient WAL files"); PRAGMA wal_checkpoint(TRUNCATE) on
# close folds them back into the main .db file so it stays whole.
docs/workable_items.db-wal
docs/workable_items.db-shm
# §11.4.30 + §11.4.95 — Go build cache + ephemeral test outputs.
/cmd/workable-items/workable-items
/cmd/workable-items/testdata/.cache/

# Transient test/validation output (§11.4.30). Curated evidence goes under docs/qa/.
qa-results/

# Agent session scratch (§11.4.30) — superpowers SDD progress ledger + remember
# buffer + docs_chain state are per-session working files, never tracked.
.superpowers/
.remember/
.docs_chain/state.json
