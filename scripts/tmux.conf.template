# vasic-digital optimized tmux configuration
# Generated by scripts/setup.sh — DO NOT edit by hand; re-run setup
# to regenerate with updated defaults. The `tmx` wrapper loads this file
# directly (tmux -f), so it is BOTH the committed template AND the live
# config — keep every line valid tmux syntax.
#
# Memory-relevant settings:
#   history-limit  50000   — large per-pane scrollback so terminal output
#                            survives. Bounded by the per-session memory
#                            cap (Linux cgroup MemoryMax / macOS host).
#   buffer-limit   20      — fewer copy-paste buffers retained (default 50)
#   status-interval 15     — slow status redraw, lower CPU usage
#
# Performance:
#   set -s escape-time 0   — no Esc-key delay (default 500 ms wastes typing time)
#   set -g focus-events on — accurate focus tracking for editors
#   set -ga terminal-overrides ',xterm-256color:Tc' — true-color support
#
# Scrolling / copy-mode (see the dedicated section below):
#   mouse on               — wheel + touch scrolling
#   mode-keys vi           — vi-style navigation in copy-mode
#   WheelUp/WheelDown      — always drive tmux's own scrollback buffer,
#                            even inside mouse-reporting TUIs (Claude Code)
#   allow-passthrough on   — Claude Code TUI passthrough (official rec.)
#   extended-keys on       — Shift+Enter etc. reach the application

# ── memory ──────────────────────────────────────────────────────────────────
set -g  history-limit       50000
set -g  buffer-limit        20

# ── performance ─────────────────────────────────────────────────────────────
set -s  escape-time         0
set -g  focus-events        on
set -g  status-interval     15

# ── terminal ────────────────────────────────────────────────────────────────
set -g  default-terminal    "screen-256color"
set -ga terminal-overrides  ',*-256color:Tc'
set -g  set-clipboard       external

# ── UX ──────────────────────────────────────────────────────────────────────
set -g  mouse               on
set -g  base-index          1
set -g  pane-base-index     1
setw -g pane-base-index     1

# ════════════════════════════════════════════════════════════════════════════
# ── SCROLLING + COPY-MODE ──────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════════════════
# Goal: scroll terminal output up/down reliably from ANY device — desktop
# mouse, laptop trackpad, and mobile (Termux on Android, where a touch-drag
# is delivered as wheel events). The problem this solves: full-screen TUIs
# such as Claude Code REQUEST mouse reporting, and tmux's default
# WheelUpPane binding then FORWARDS the wheel to the application instead of
# scrolling tmux's own scrollback. The bindings below override that: the
# wheel ALWAYS drives tmux copy-mode scrollback, so the operator can always
# scroll back through real output history regardless of the running app.

# vi-style keys in copy-mode: k/j to move, Ctrl-u/Ctrl-d half-page,
# g/G top/bottom, `/` search forward, `?` search back, q to exit.
setw -g mode-keys           vi

# Wheel / touch-scroll UP: enter copy-mode (if not already in it) and
# scroll the scrollback buffer up. `copy-mode -e` makes copy-mode exit
# automatically once you scroll back down to the bottom. Kept on ONE
# line so the paired mutation (meta-test M12) can delete it cleanly.
bind -n WheelUpPane if -F '#{pane_in_mode}' 'send-keys -X -N 3 scroll-up' 'copy-mode -e ; send-keys -X -N 3 scroll-up'

# Wheel / touch-scroll DOWN: scroll the buffer down while in copy-mode;
# outside copy-mode forward the event to the application.
bind -n WheelDownPane if -F '#{pane_in_mode}' 'send-keys -X -N 3 scroll-down' 'send-keys -M'

# Non-mouse scrolling (essential on a phone keyboard / hardware keyboard):
#   prefix + [        enter copy-mode, then PageUp/PageDown/arrows/k/j
#   prefix + PageUp   enter copy-mode AND page up in one motion
bind PageUp copy-mode -eu

# OS-adaptive clipboard: at copy time, route the selection to whichever
# clipboard tool exists on THIS machine — pbcopy (macOS), wl-copy
# (Wayland), xclip (X11), termux-clipboard-set (Termux/Android). If none
# exist the selection still lands in tmux's own paste buffer and is
# forwarded to the outer terminal via OSC-52 (set-clipboard external).
set -g @clip 'sh -c "command -v pbcopy >/dev/null 2>&1 && exec pbcopy; command -v wl-copy >/dev/null 2>&1 && exec wl-copy; command -v xclip >/dev/null 2>&1 && exec xclip -selection clipboard -in; command -v termux-clipboard-set >/dev/null 2>&1 && exec termux-clipboard-set; exec cat >/dev/null"'

# copy-mode-vi: v starts a selection, y / Enter copy it to the clipboard,
# a mouse drag-release copies the dragged selection.
bind -T copy-mode-vi v                  send-keys -X begin-selection
bind -T copy-mode-vi y                  send-keys -X copy-pipe-and-cancel "#{@clip}"
bind -T copy-mode-vi Enter              send-keys -X copy-pipe-and-cancel "#{@clip}"
bind -T copy-mode-vi MouseDragEnd1Pane  send-keys -X copy-pipe-and-cancel "#{@clip}"

# ── Multi-line + alt-screen TUI selection overrides (v1.0.15) ─────────
# Forensic anchor: operator mandate 2026-05-28 — "multi-line copy +
# scrolling MUST work everywhere, especially inside Claude Code".
# When an app (Claude Code, vim, less, htop) requests mouse tracking
# (`#{mouse_any_flag}`=1), tmux's DEFAULT MouseDrag1Pane forwards the
# drag to the app via `send -M`, so a normal click+drag inside the
# app never reaches tmux copy-mode and the user cannot select text.
# PRIMARY fix (v1.0.18, forensic anchor: user report 2026-05-29 — "we still
# cannot select and copy anything in Claude Code … MUST work on Linux AND
# macOS"). A PLAIN left-drag ALWAYS enters tmux copy-mode and begins a
# selection, EVEN when the foreground app requests mouse tracking
# (`#{mouse_any_flag}`, e.g. Claude Code / vim / less / htop). On release the
# `MouseDragEnd1Pane` binding (above) pipes the selection to the OS clipboard
# via @clip. This is the override of tmux's default root `MouseDrag1Pane`,
# which otherwise forwards the drag to the app (`send -M`) so selection is
# impossible. `#{pane_in_mode}` guard: once already in copy-mode, pass the
# drag through (`send -M`) so copy-mode's own MouseDrag1Pane extends the
# selection. A plain CLICK (MouseDown/Up, no drag) and the WHEEL are NOT
# rebound here, so they still reach the app — Claude Code keeps its click +
# scroll interactivity; only click-DRAG is repurposed for select-and-copy
# (Claude Code's TUI does not use drag). Works identically on macOS + Linux
# because it depends on no terminal-specific modifier. Proven with a REAL
# mouse drag → OS clipboard in tests 55 + 56.
bind -n MouseDrag1Pane if -F '#{pane_in_mode}' 'send -M' 'copy-mode -M'

# DEDICATED modifier paths (retained as alternatives): Alt-drag (macOS
# terminals that pass M- through) / Shift-drag (terminal-agnostic) also force
# copy-mode. Note: on iTerm2 with default "Option Key Sends = Normal",
# Option-drag is consumed by iTerm2's own native-selection bypass and never
# reaches tmux — Shift-drag and the plain-drag override above are the reliable
# paths there.
bind -n M-MouseDrag1Pane  copy-mode -M
bind -n S-MouseDrag1Pane  copy-mode -M

# Modifier-drag END: when the drag was started with M- / S- modifier
# and ends in copy-mode, route the selection through @clip (same
# pipe as the plain `y` / `Enter` / MouseDragEnd1Pane bindings).
bind -T copy-mode-vi M-MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "#{@clip}"
bind -T copy-mode-vi S-MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "#{@clip}"

# ── Quick mouse toggle: prefix + m ────────────────────────────────────
# Forensic anchor: user report 2026-05-29 — "cannot select/copy with the
# mouse in any tmx window, especially inside Claude Code". Two facts make
# a single muscle-memory gesture unreliable across terminals: (1) inside a
# mouse-tracking app a PLAIN drag is forwarded to the app (by design, so the
# app's own mouse keeps working); (2) on iTerm2 with the default
# "Option Key Sends = Normal", Option/Alt-drag is consumed by iTerm2's OWN
# native-selection bypass and never reaches tmux's M-MouseDrag1Pane. That
# leaves Shift-drag (above) as the reliable IN-TMUX select gesture.
#
# `prefix m` is the robust, terminal-AGNOSTIC escape hatch: it toggles
# `mouse` off, so the OUTER terminal's NATIVE selection (iTerm2 / Terminal.app
# / WezTerm drag -> Cmd-C / right-click -> Copy) works EVERYWHERE, including
# inside Claude Code. Press `prefix m` again to restore tmux mouse scrollback
# + copy-mode. The status line confirms the new state.
bind m set -g mouse \; display-message 'mouse #{?mouse,ON (tmux selection: drag, or Shift-drag in apps),OFF (use native terminal selection: drag + Cmd-C)}'

# ── Paste-INTO from OS clipboard (v1.0.15) ────────────────────────────
# `set-clipboard external` (set above) is COPY-OUT only — OSC-52 is
# not standardised for paste. To paste OS clipboard contents INTO a
# pane via a tmux keystroke we need an explicit binding that pipes
# the system clipboard through `tmux load-buffer -` and then
# `paste-buffer -p`. The `@clip-read` user option is the OS-adaptive
# READ counterpart to `@clip` (write): pbpaste on macOS, wl-paste -n
# on Wayland, xclip -o on X11, termux-clipboard-get on Termux/Android.
# Bound to `prefix + P` (capital — lowercase p is tmux's
# previous-window). See test 46 for the physical paste-IN proof.
set -g @clip-read 'sh -c "command -v pbpaste >/dev/null 2>&1 && exec pbpaste; command -v wl-paste >/dev/null 2>&1 && exec wl-paste -n; command -v xclip >/dev/null 2>&1 && exec xclip -o -selection clipboard; command -v termux-clipboard-get >/dev/null 2>&1 && exec termux-clipboard-get; printf \"\""'

bind P run -b 'tmux load-buffer - <<< "$(#{@clip-read})" \; tmux paste-buffer -p'

# ════════════════════════════════════════════════════════════════════════════
# ── CLAUDE CODE TUI PASSTHROUGH (official Claude Code tmux recommendations) ─
# ════════════════════════════════════════════════════════════════════════════
# allow-passthrough — lets an application send escape sequences straight
#   through tmux (image protocols, OSC desktop notifications, etc.).
# extended-keys + terminal-features extkeys — make modified keys such as
#   Shift+Enter (inserts a newline in Claude Code's prompt) reach the
#   application instead of being collapsed by tmux's key parser.
set -g  allow-passthrough   on
set -s  extended-keys       on
set -as terminal-features   'xterm*:extkeys'

# ── status line — minimal ───────────────────────────────────────────────────
# status-right: show TMX_HOSTNAME (forwarded by the wrapper, e.g. "Mistborn"
# on macOS) when set; fall back to tmux's `#h` (short hostname). Without
# this conditional, tmux's default status-right would show the VM's
# pane-title which resolves to "localhost.localdomain" — not what the
# operator's macOS terminal would naturally display.
set -g  status-left         "[#S] "
set -g  status-right        "#{?TMX_HOSTNAME,#{TMX_HOSTNAME},#h} %H:%M %d-%b"
set -g  status-left-length  20
set -g  status-right-length 40

# ── window-name cleanup: strip ".exe" suffix from auto-rename ──────────────
# Some bundled CLIs (notably Claude Code v2.x on macOS — the packaged binary
# is literally `bin/claude.exe` Mach-O regardless of host OS) report
# pane_current_command with a `.exe` extension that bleeds into the
# status-bar window name (the colored bottom-left segment shows
# `[session] N:claude.exe`). The kernel `comm` field carries the on-disk
# filename, so this is a packaging quirk of the upstream tool, NOT of tmx.
# We strip it cosmetically at the tmux format layer.
#
# Escape note: the conf-file string parser strips one backslash level, so
# `\\.` becomes `\.` for the regex engine — a literal-dot anchor. Without
# the escape, the unescaped `.` would also strip names like `bashexe`
# (regex `.exe$` matches `shexe`).
set -g  automatic-rename            on
set -g  automatic-rename-format     "#{s/\\.exe$//:pane_current_command}"

# ── prefix — keep default C-b (don't break operator muscle memory) ──────────
# (uncomment if you prefer C-a)
# unbind C-b
# set -g prefix C-a
# bind C-a send-prefix
