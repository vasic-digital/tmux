#!/usr/bin/env bash
# tmx — wrapper for the locally-built tmux that:
#   1. Pre-loads jemalloc (more aggressive RAM return than glibc malloc) when available
#   2. Sets oom_score_adj=-500 on the spawned tmux server (if the
#      setcap-enabled tmx-oom-set helper is installed; otherwise
#      attempts a direct write which silently no-ops for non-root operators)
#
# Generated by scripts/setup.sh.
# Placeholders __TMUX_BIN__ and __JEMALLOC_PATH__ filled in at generation.

set -u

TMUX_BIN="__TMUX_BIN__"
TMX_CLASSIFICATION=""    # set by _probe_topology()
JEMALLOC_PATH="__JEMALLOC_PATH__"
OOM_HELPER="/usr/local/bin/tmx-oom-set"
TMX_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -n "$JEMALLOC_PATH" ] && [ -f "$JEMALLOC_PATH" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$JEMALLOC_PATH"
fi

# Apply OOM score: prefer setcap-enabled helper, fall back to direct write
# (works only as root). Silent no-op if neither is available.
_apply_oom_score() {
    local sock="${1:-}"
    # If no -S socket was passed, tmux uses its default socket. The previous
    # version bailed out here, which silently disabled OOM protection AND
    # status colour for the operator's primary use case (`tmx new` without
    # an explicit socket). Fix: build the tmux-targeting args dynamically.
    local -a target=()
    [ -n "$sock" ] && target=(-S "$sock")
    sleep 0.3
    local server_pid
    server_pid=$("$TMUX_BIN" "${target[@]}" display-message -p '#{pid}' 2>/dev/null || true)
    [ -n "$server_pid" ] || return 0
    if [ -x "$OOM_HELPER" ]; then
        # Helper has cap_sys_resource+ep — works for non-root operator
        "$OOM_HELPER" "$server_pid" -500 >/dev/null 2>&1 || true
    elif [ "$(id -u)" = "0" ] && [ -w "/proc/$server_pid/oom_score_adj" ]; then
        echo -500 > "/proc/$server_pid/oom_score_adj" 2>/dev/null || true
    fi
    # else: silently degrade — operator can install helper any time via
    # sudo bash scripts/build_oom_set.sh --install
}

# Apply hostname-derived status-bg colour — set on the running server so
# the tmux status line visually distinguishes this host from others.
# Deterministic: same hostname always produces the same colour.
_apply_host_color() {
    local sock="${1:-}"
    # Mirror _apply_oom_score: omit -S when no explicit socket was passed
    # so tmux talks to its default socket. The previous early-return left
    # the status bar at tmux's default (bg=green) — operator saw green for
    # all hosts, defeating the §11.4 'positive evidence of host distinguish-
    # ability' that test 11 claims to provide.
    local -a target=()
    [ -n "$sock" ] && target=(-S "$sock")
    sleep 0.3
    local color
    # If TMX_HOSTNAME is set (forwarded by the macOS bridge), use it so
    # the colour reflects the operator's host (e.g., "Mistborn") rather
    # than the VM's generic "localhost.localdomain". On Linux-native the
    # var is unset → hostname_color.sh falls back to $(hostname).
    color=$("$TMX_DIR/hostname_color.sh" ${TMX_HOSTNAME:+"$TMX_HOSTNAME"} 2>/dev/null) || color="green"
    "$TMUX_BIN" "${target[@]}" set -g status-style "bg=$color" 2>/dev/null || true
}

# Probe host topology (systemd version, cgroup hierarchy) and classify.
# Implements §11.4.3 per-host-topology dispatch seam.
# Classification: tmx-supported | tmx-degraded | tmx-unsupported
_scope_ok=0  # 1 = systemd-run --user --scope works
_probe_topology() {
    local sd_ver=0
    if command -v systemctl >/dev/null 2>&1; then
        sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}')
    fi
    # Functional probe: try creating a transient scope
    if [ "${sd_ver:-0}" -ge 230 ] 2>/dev/null && \
       systemd-run --user --scope --collect --quiet \
           bash -c "exit 0" 2>/dev/null; then
        _scope_ok=1
    fi
}
_probe_topology
export TMX_CLASSIFICATION
if [ "$_scope_ok" -eq 1 ]; then
    TMX_CLASSIFICATION="tmx-supported"
else
    TMX_CLASSIFICATION="tmx-degraded"
fi

# Parse out -S socket arg
SOCK=""
i=1
for arg in "$@"; do
    if [ "$arg" = "-S" ]; then
        eval "SOCK=\${$((i+1)):-}"
        break
    fi
    i=$((i+1))
done

if [ "$#" -eq 0 ] || echo " $* " | grep -qE ' (new-session|new|start-server) '; then
    # Detect whether the operator wants an interactive attach. tmux's
    # `new`/`new-session` without `-d` creates the session AND attaches
    # the calling terminal — needs a TTY. Our wrapper's previous design
    # `cmd &; _apply_*; wait` backgrounded the tmux client, which
    # disconnects it from the controlling terminal's foreground process
    # group → "open terminal failed: not a terminal" for interactive use.
    #
    # Fix: split the lifecycle. Create the session DETACHED in the
    # cgroup-scoped server, apply OOM + colour, THEN exec a foreground
    # attach (or exit silently if the operator passed -d themselves).
    INTERACTIVE=1
    for a in "$@"; do
        case "$a" in
            -d|-D) INTERACTIVE=0 ;;
        esac
    done

    # Build args: ensure tmux starts detached so the wrapper retains TTY
    # control for the subsequent attach.
    NEW_ARGS=()
    INJECTED_D=0
    if [ "$INTERACTIVE" -eq 1 ]; then
        for a in "$@"; do
            NEW_ARGS+=("$a")
            case "$a" in
                new|new-session|start-server)
                    if [ "$INJECTED_D" -eq 0 ]; then
                        NEW_ARGS+=("-d")
                        INJECTED_D=1
                    fi
                    ;;
            esac
        done
        # If no subcommand keyword was present (bare `tmx`), prefix new -d.
        if [ "$INJECTED_D" -eq 0 ]; then
            NEW_ARGS=("new-session" "-d" "${NEW_ARGS[@]}")
            INJECTED_D=1
        fi
    else
        NEW_ARGS=("$@")
    fi

    # Step 1: create the session inside the cgroup-scoped server (detached).
    if [ "$_scope_ok" -eq 1 ]; then
        systemd-run --user --scope --collect --quiet \
            -p "MemoryMax=${TMX_MEM:-8G}" \
            -p "CPUQuota=${TMX_CPU:-200}%" \
            -p "TasksMax=4096" \
            -p "Delegate=yes" \
            "$TMUX_BIN" "${NEW_ARGS[@]}"
    else
        "$TMUX_BIN" "${NEW_ARGS[@]}"
    fi

    # Step 2: apply colour + OOM score on the now-running server.
    _apply_oom_score "$SOCK"
    _apply_host_color "$SOCK"

    # Step 3: if the user wanted interactive, attach in foreground (TTY).
    if [ "$INTERACTIVE" -eq 1 ]; then
        if [ -n "$SOCK" ]; then
            exec "$TMUX_BIN" -S "$SOCK" attach
        else
            exec "$TMUX_BIN" attach
        fi
    fi
else
    # For attach/ls/kill: set colour if socket exists, then exec.
    _apply_host_color "$SOCK"
    exec "$TMUX_BIN" "$@"
fi
