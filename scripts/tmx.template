#!/usr/bin/env bash
# tmx — wrapper for the locally-built tmux that:
#   1. Pre-loads jemalloc (more aggressive RAM return than glibc malloc) when available
#   2. Sets oom_score_adj=-500 on the spawned tmux server (if the
#      setcap-enabled atmosphere-oom-set helper is installed; otherwise
#      attempts a direct write which silently no-ops for non-root operators)
#
# Generated by scripts/setup_tmux.sh.
# Placeholders __TMUX_BIN__ and __JEMALLOC_PATH__ filled in at generation.

set -u

TMUX_BIN="__TMUX_BIN__"
JEMALLOC_PATH="__JEMALLOC_PATH__"
OOM_HELPER="/usr/local/bin/tmx-oom-set"
TMX_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -n "$JEMALLOC_PATH" ] && [ -f "$JEMALLOC_PATH" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$JEMALLOC_PATH"
fi

# Apply OOM score: prefer setcap-enabled helper, fall back to direct write
# (works only as root). Silent no-op if neither is available.
_apply_oom_score() {
    local sock="${1:-}"
    [ -n "$sock" ] || return 0
    sleep 0.3
    local server_pid
    server_pid=$("$TMUX_BIN" -S "$sock" display-message -p '#{pid}' 2>/dev/null || true)
    [ -n "$server_pid" ] || return 0
    if [ -x "$OOM_HELPER" ]; then
        # Helper has cap_sys_resource+ep — works for non-root operator
        "$OOM_HELPER" "$server_pid" -500 >/dev/null 2>&1 || true
    elif [ "$(id -u)" = "0" ] && [ -w "/proc/$server_pid/oom_score_adj" ]; then
        echo -500 > "/proc/$server_pid/oom_score_adj" 2>/dev/null || true
    fi
    # else: silently degrade — operator can install helper any time via
    # sudo bash scripts/build_oom_set.sh --install
}

# Apply hostname-derived status-bg colour — set on the running server so
# the tmux status line visually distinguishes this host from others.
# Deterministic: same hostname always produces the same colour.
_apply_host_color() {
    local sock="${1:-}"
    [ -n "$sock" ] || return 0
    sleep 0.3
    local color
    color=$("$TMX_DIR/hostname_color.sh" 2>/dev/null) || color="green"
    "$TMUX_BIN" -S "$sock" set -g status-style "bg=$color" 2>/dev/null || true
}

# Parse out -S socket arg
SOCK=""
i=1
for arg in "$@"; do
    if [ "$arg" = "-S" ]; then
        eval "SOCK=\${$((i+1)):-}"
        break
    fi
    i=$((i+1))
done

if [ "$#" -eq 0 ] || echo " $* " | grep -qE ' (new-session|new|start-server) '; then
    "$TMUX_BIN" "$@" &
    TMUX_PID=$!
    _apply_oom_score "$SOCK"
    _apply_host_color "$SOCK"
    wait $TMUX_PID
else
    # For attach/ls/kill: set colour if socket exists, then exec
    _apply_host_color "$SOCK"
    exec "$TMUX_BIN" "$@"
fi
