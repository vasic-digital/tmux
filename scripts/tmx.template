#!/usr/bin/env bash
# tmx — per-session isolated wrapper for the locally-built tmux.
#
# Architecture (per docs/PER_SESSION_ISOLATION_PLAN.md §1):
#   Each `tmx new -s NAME` creates a SEPARATE tmux server (socket
#   `tmx-NAME` in $XDG_RUNTIME_DIR/tmux-<uid>/), bound to its own
#   cgroup-v2 transient scope `tmx-NAME.scope` with operator-configured
#   MemoryMax + CPUQuota + TasksMax. OOM in one session affects ONLY
#   that scope; every other session and the user.slice survive.
#
# Operator commands (the supported subset; everything else passes
# through with `-L tmx-NAME` injected when `-t NAME` is present):
#   tmx new -s NAME [-d]    → spawn new isolated server in its own scope
#   tmx attach -t NAME      → attach to NAME's server
#   tmx ls                  → list sessions across ALL our servers
#   tmx kill-session -t N   → kill N's session + stop its scope
#   tmx kill-server         → kill all our servers + stop all our scopes
#   tmx send-keys -t N …    → target N's server
#   tmx <anything> -t N …   → pass through with derived socket
#
# Generated by scripts/setup.sh.
# Placeholders __TMUX_BIN__ and __JEMALLOC_PATH__ filled in at generation.

set -u

TMUX_BIN="__TMUX_BIN__"
JEMALLOC_PATH="__JEMALLOC_PATH__"
OOM_HELPER="/usr/local/bin/tmx-oom-set"
TMX_DIR="$(cd "$(dirname "$0")" && pwd)"
TMX_SOCK_PREFIX="tmx-"           # -L prefix; sockets land in $XDG_RUNTIME_DIR/tmux-<uid>/tmx-NAME
TMX_SCOPE_PREFIX="tmx-"          # systemd-unit prefix; .scope suffix added
TMX_CLASSIFICATION=""

if [ -n "$JEMALLOC_PATH" ] && [ -f "$JEMALLOC_PATH" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$JEMALLOC_PATH"
fi

# ── helpers ──────────────────────────────────────────────────────────

# Sanitise a session name into a systemd-unit-safe token.
# Allowed: [A-Za-z0-9._-]; everything else → `_`. Per the operator decision
# (2026-05-13): replace invalid chars, error on collision (no auto-uniquify).
_sanitise() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

# Host-adaptive default MemoryMax: §12.6 budget shared across an assumed
# 4 concurrent sessions, floored at 2 GB.
#   MEM_MB = max(MemTotal_MB * 60 / 100 / 4, 2048)
_default_mem_mb() {
    local total_kb mb
    total_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "${total_kb:-0}" -gt 0 ] 2>/dev/null; then
        mb=$(( total_kb / 1024 * 60 / 100 / 4 ))
    else
        mb=2048
    fi
    [ "$mb" -lt 2048 ] && mb=2048
    printf '%d' "$mb"
}

# Probe topology: systemd ≥ 230 + functional --user --scope.
_scope_ok=0
_probe_topology() {
    local sd_ver=0
    if command -v systemctl >/dev/null 2>&1; then
        sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}')
    fi
    if [ "${sd_ver:-0}" -ge 230 ] 2>/dev/null && \
       systemd-run --user --scope --collect --quiet \
           bash -c "exit 0" 2>/dev/null; then
        _scope_ok=1
    fi
}
_probe_topology
if [ "$_scope_ok" -eq 1 ]; then
    TMX_CLASSIFICATION="tmx-supported"
else
    TMX_CLASSIFICATION="tmx-degraded"
fi
export TMX_CLASSIFICATION

# Apply oom_score_adj=-500 on a specific tmux server (identified by -L).
_apply_oom_score() {
    local sock_label="$1"
    sleep 0.3
    local server_pid
    server_pid=$("$TMUX_BIN" -L "$sock_label" display-message -p '#{pid}' 2>/dev/null || true)
    [ -n "$server_pid" ] || return 0
    if [ -x "$OOM_HELPER" ]; then
        "$OOM_HELPER" "$server_pid" -500 >/dev/null 2>&1 || true
    elif [ "$(id -u)" = "0" ] && [ -w "/proc/$server_pid/oom_score_adj" ]; then
        echo -500 > "/proc/$server_pid/oom_score_adj" 2>/dev/null || true
    fi
}

# Apply hostname-derived status-bar bg colour on a specific tmux server.
_apply_host_color() {
    local sock_label="$1"
    sleep 0.3
    local color
    color=$("$TMX_DIR/hostname_color.sh" ${TMX_HOSTNAME:+"$TMX_HOSTNAME"} 2>/dev/null) || color="green"
    "$TMUX_BIN" -L "$sock_label" set -g status-style "bg=$color" 2>/dev/null || true
}

# Enumerate all of OUR sockets (active tmux servers we spawned).
# Tmux's default socket directory is /tmp/tmux-<uid> unless TMUX_TMPDIR
# overrides it. Check both candidates.
_our_sockets() {
    local rt
    for rt in "${TMUX_TMPDIR:-}/tmux-$(id -u)" "/tmp/tmux-$(id -u)"; do
        [ -d "$rt" ] || continue
        ls -1 "$rt" 2>/dev/null | grep "^${TMX_SOCK_PREFIX}" || true
        return 0
    done
}

# Print our session list across all our servers.
_list_all_sessions() {
    local sock
    while IFS= read -r sock; do
        [ -z "$sock" ] && continue
        "$TMUX_BIN" -L "$sock" ls 2>/dev/null || true
    done < <(_our_sockets)
}

# ── arg parsing ──────────────────────────────────────────────────────

# First positional after flags is the tmux subcommand.
SUBCMD=""
for a in "$@"; do
    case "$a" in
        -[a-zA-Z]*) ;;
        *) SUBCMD="$a"; break ;;
    esac
done

# Extract -s SESSION (for new), -t TARGET (for attach/send-keys/etc),
# and -L SOCKET-LABEL (if operator explicitly passed one).
SESSION_ARG=""
TARGET_ARG=""
EXPLICIT_LABEL=""
i=0
for a in "$@"; do
    i=$((i+1))
    case "$a" in
        -s) eval "SESSION_ARG=\${$((i+1)):-}";;
        -t) eval "TARGET_ARG=\${$((i+1)):-}";;
        -L) eval "EXPLICIT_LABEL=\${$((i+1)):-}";;
    esac
done

# Derive the socket label and scope name from session/target.
NAME=""
[ -n "$SESSION_ARG" ] && NAME="$SESSION_ARG"
[ -z "$NAME" ] && [ -n "$TARGET_ARG" ] && NAME="$TARGET_ARG"
[ -z "$NAME" ] && NAME="default"

SAFE_NAME=$(_sanitise "$NAME")
SOCK_LABEL="${TMX_SOCK_PREFIX}${SAFE_NAME}"
SCOPE_UNIT="${TMX_SCOPE_PREFIX}${SAFE_NAME}.scope"

# Honour operator's explicit -L when present (do not auto-derive).
[ -n "$EXPLICIT_LABEL" ] && SOCK_LABEL="$EXPLICIT_LABEL"

# ── dispatch ─────────────────────────────────────────────────────────

# All-flag invocations (`tmx -V`, `tmx -h`, `tmx --version`) have no
# SUBCMD but ARE flag-only — they query the tmux binary without
# spawning a session. Pass through to tmux directly.
if [ -z "$SUBCMD" ] && [ "$#" -gt 0 ] && [ "${1#-}" != "$1" ]; then
    exec "$TMUX_BIN" "$@"
fi

case "$SUBCMD" in
    new|new-session|start-server|"")
        # Collision check: a scope with this name MUST NOT already be active.
        if [ "$_scope_ok" -eq 1 ] && \
           systemctl --user is-active --quiet "$SCOPE_UNIT" 2>/dev/null; then
            echo "tmx: refusing to create session '$NAME' — scope $SCOPE_UNIT is already active." >&2
            echo "     run 'tmx kill-session -t $NAME' to release it, or pick a different name." >&2
            exit 4
        fi

        # Compute MemoryMax (operator override wins; otherwise host-adaptive).
        MEM_MB=$(_default_mem_mb)
        TMX_MEM_EFFECTIVE="${TMX_MEM:-${MEM_MB}M}"
        TMX_CPU_EFFECTIVE="${TMX_CPU:-200}"

        # Detect interactive (no -d/-D).
        INTERACTIVE=1
        for a in "$@"; do
            case "$a" in -d|-D) INTERACTIVE=0 ;; esac
        done

        # Build the tmux invocation. Force `-L SOCK_LABEL` so this session's
        # server is on its own socket. Inject `-d` so the server starts
        # detached and we can apply colour/OOM before optional attach.
        NEW_ARGS=("-L" "$SOCK_LABEL")
        SAW_NEW=0
        for a in "$@"; do
            case "$a" in
                -L)   continue ;;  # we already added our own
            esac
            NEW_ARGS+=("$a")
            case "$a" in
                new|new-session|start-server)
                    if [ "$INTERACTIVE" -eq 1 ] && [ "$SAW_NEW" -eq 0 ]; then
                        NEW_ARGS+=("-d")
                        SAW_NEW=1
                    fi
                    ;;
            esac
        done
        # Filter out the value that followed -L in the original args.
        # (Simple two-pass: rebuild without the consumed -L NAME pair.)
        if [ -n "$EXPLICIT_LABEL" ]; then
            REBUILT=("-L" "$SOCK_LABEL")
            skip_next=0
            for a in "${NEW_ARGS[@]:2}"; do
                if [ "$skip_next" = "1" ]; then skip_next=0; continue; fi
                if [ "$a" = "-L" ]; then skip_next=1; continue; fi
                REBUILT+=("$a")
            done
            NEW_ARGS=("${REBUILT[@]}")
        fi
        # If no subcommand keyword was present, prefix `new-session -d -s NAME`.
        if [ "$SAW_NEW" -eq 0 ] && [ "$INTERACTIVE" -eq 1 ]; then
            NEW_ARGS=("-L" "$SOCK_LABEL" "new-session" "-d" "-s" "$NAME")
            SAW_NEW=1
        fi

        # Step 1: create scope + tmux server. systemd-run --user --scope
        # with --unit gives this session a deterministic cgroup path the
        # operator can target by name (`systemctl --user stop tmx-NAME.scope`).
        if [ "$_scope_ok" -eq 1 ]; then
            systemd-run --user --scope --quiet \
                --unit="$SCOPE_UNIT" \
                -p "MemoryMax=$TMX_MEM_EFFECTIVE" \
                -p "CPUQuota=${TMX_CPU_EFFECTIVE}%" \
                -p "TasksMax=4096" \
                -p "Delegate=yes" \
                "$TMUX_BIN" "${NEW_ARGS[@]}"
        else
            "$TMUX_BIN" "${NEW_ARGS[@]}"
        fi

        # Step 2: apply colour + OOM score on the now-running server.
        _apply_oom_score "$SOCK_LABEL"
        _apply_host_color "$SOCK_LABEL"

        # Step 3: if the user wanted interactive, attach in foreground.
        if [ "$INTERACTIVE" -eq 1 ]; then
            exec "$TMUX_BIN" -L "$SOCK_LABEL" attach -t "$NAME"
        fi
        ;;

    ls|list-sessions)
        # Aggregate across all our sockets.
        _list_all_sessions
        ;;

    kill-server)
        # Stop ALL our servers + scopes.
        while IFS= read -r sock; do
            [ -z "$sock" ] && continue
            "$TMUX_BIN" -L "$sock" kill-server 2>/dev/null || true
            local_scope="${TMX_SCOPE_PREFIX}${sock#${TMX_SOCK_PREFIX}}.scope"
            systemctl --user stop "$local_scope" 2>/dev/null || true
        done < <(_our_sockets)
        ;;

    kill-session)
        # Kill the named session, then stop its scope explicitly
        # (operator decision 2026-05-13: belt-and-suspenders cleanup).
        "$TMUX_BIN" -L "$SOCK_LABEL" kill-session -t "$NAME" 2>/dev/null || true
        # If the server has no remaining sessions, it'll exit; either way:
        systemctl --user stop "$SCOPE_UNIT" 2>/dev/null || true
        ;;

    attach|attach-session|a)
        # Just attach. Server must already exist.
        exec "$TMUX_BIN" -L "$SOCK_LABEL" "$@"
        ;;

    *)
        # Pass-through. If a target is named, route to that server's socket.
        if [ -n "$TARGET_ARG" ]; then
            exec "$TMUX_BIN" -L "$SOCK_LABEL" "$@"
        elif [ -n "$EXPLICIT_LABEL" ]; then
            exec "$TMUX_BIN" "$@"
        else
            # No target → ambiguous in a multi-server world. Try the most
            # recent server (first listed). Operator can pass -t for clarity.
            FIRST_SOCK=$(_our_sockets | head -1)
            if [ -n "$FIRST_SOCK" ]; then
                exec "$TMUX_BIN" -L "$FIRST_SOCK" "$@"
            else
                exec "$TMUX_BIN" "$@"
            fi
        fi
        ;;
esac
