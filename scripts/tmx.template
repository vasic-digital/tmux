#!/usr/bin/env bash
# tmx — native dual-OS wrapper for the locally-built tmux.
#
# Architecture (per docs/NATIVE_DUAL_OS_PLAN.md):
#   * On the operator's HOST OS (Linux or macOS), each `tmx new -s NAME`
#     spawns a separate tmux server (socket `tmx-NAME`) and wraps the
#     session's initial shell in the OS-native isolation primitive:
#       - Linux : systemd-run --user --scope --unit=tmx-NAME.scope
#                 -p MemoryMax=… -p CPUQuota=… -p TasksMax=… -p Delegate=yes
#       - macOS : scripts/tmx-rlimit-wrapper.sh sets RLIMIT_AS / CPU /
#                 NPROC before exec'ing $SHELL
#   * The session's shell sees the FULL HOST ENVIRONMENT: same PATH
#     (including Homebrew on macOS, /usr/local/bin on Linux), same
#     filesystem, same user. Resource caps are kernel-enforced; nothing
#     else is sandboxed away.
#
# Operator commands (the supported subset; everything else passes
# through with `-L tmx-NAME` injected when `-t NAME` is present):
#   tmx new -s NAME [-d]    → spawn new isolated server in its own scope/rlimit
#   tmx attach -t NAME      → attach to NAME's server
#   tmx ls                  → list sessions across ALL our servers
#   tmx kill-session -t N   → kill N's session + stop its scope (Linux)
#   tmx kill-server         → kill all our servers + stop all our scopes
#   tmx send-keys -t N …    → target N's server
#   tmx <anything> -t N …   → pass through with derived socket
#
# Generated by scripts/setup.sh.
# Placeholders __TMUX_BIN__, __JEMALLOC_SO__, __JEMALLOC_LIBDIR__,
# __RLIMIT_WRAPPER__ filled in at generation. __JEMALLOC_SO__ /
# __JEMALLOC_LIBDIR__ come from .local-deps/<plat>/resolved.env, written
# by scripts/obtain_local_deps.sh and substituted by setup.sh step 3
# (the resolved ABSOLUTE path — §11.4.111 resolve-by-stable-identity).

set -u

TMUX_BIN="__TMUX_BIN__"
JEMALLOC_SO="__JEMALLOC_SO__"
JEMALLOC_LIBDIR="__JEMALLOC_LIBDIR__"
RLIMIT_WRAPPER="__RLIMIT_WRAPPER__"
OOM_HELPER="/usr/local/bin/tmx-oom-set"
TMX_DIR="$(cd "$(dirname "$0")" && pwd)"
TMX_SOCK_PREFIX="tmx-"
TMX_SCOPE_PREFIX="tmx-"
TMX_CLASSIFICATION=""
HOST_OS="$(uname -s)"

# Pure per-session color helpers (sourced so they are unit-testable in
# isolation by scripts/tests/64_session_color_parse_unit.sh). §102.
if [ -f "$TMX_DIR/tmx-color-lib.sh" ]; then
    # shellcheck disable=SC1091
    . "$TMX_DIR/tmx-color-lib.sh"
fi

# ── jemalloc preload (per-OS env-var name) ────────────────────────────
# $JEMALLOC_SO is the resolved ABSOLUTE path to libjemalloc.so.2 / .dylib
# (from .local-deps/<plat>/resolved.env, substituted by setup.sh).
# LD_PRELOAD does NOT consult rpath/RUNPATH (man7 ld.so) → it MUST be the
# absolute path, never a bare soname. $JEMALLOC_LIBDIR additionally feeds
# LD_LIBRARY_PATH so the binary's DT_NEEDED jemalloc resolves even when the
# binary carries no rpath (patchelf absent — §11.4.3 honest fallback).
# Linux uses LD_PRELOAD + LD_LIBRARY_PATH; Darwin uses DYLD_INSERT_LIBRARIES
# + DYLD_LIBRARY_PATH (+ DYLD_FORCE_FLAT_NAMESPACE=1 for the interposition).
if [ -n "$JEMALLOC_SO" ] && [ -f "$JEMALLOC_SO" ]; then
    case "$HOST_OS" in
        Darwin)
            export DYLD_INSERT_LIBRARIES="${DYLD_INSERT_LIBRARIES:+$DYLD_INSERT_LIBRARIES:}$JEMALLOC_SO"
            export DYLD_FORCE_FLAT_NAMESPACE=1
            [ -n "$JEMALLOC_LIBDIR" ] && \
                export DYLD_LIBRARY_PATH="${JEMALLOC_LIBDIR}${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
            ;;
        *)
            export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$JEMALLOC_SO"
            [ -n "$JEMALLOC_LIBDIR" ] && \
                export LD_LIBRARY_PATH="${JEMALLOC_LIBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
            ;;
    esac
fi

# Filter benign libtinfo / loader version-mismatch warnings (cosmetic).
exec 2> >(grep --line-buffered -v 'libtinfo\.so\.[0-9]\+: no version information available' >&2)

# ── helpers ──────────────────────────────────────────────────────────

# Sanitise a session name into a unit-name / socket-label safe token.
_sanitise() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

# Host-adaptive default MemoryMax (per Constitution §12.6 budget shared
# across an assumed 4 concurrent sessions, floored at 2 GB).
_default_mem_mb() {
    local total_kb mb
    case "$HOST_OS" in
        Darwin)
            # sysctl returns bytes; convert to KB.
            total_kb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 ))
            ;;
        *)
            total_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 0)
            ;;
    esac
    if [ "${total_kb:-0}" -gt 0 ] 2>/dev/null; then
        mb=$(( total_kb / 1024 * 60 / 100 / 4 ))
    else
        mb=2048
    fi
    [ "$mb" -lt 2048 ] && mb=2048
    printf '%d' "$mb"
}

# Probe Linux topology (systemd ≥ 230 + functional --user --scope).
# On macOS this is a no-op; isolation uses rlimit instead.
_scope_ok=0
if [ "$HOST_OS" = "Linux" ]; then
    sd_ver=0
    if command -v systemctl >/dev/null 2>&1; then
        sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}')
    fi
    if [ "${sd_ver:-0}" -ge 230 ] 2>/dev/null && \
       systemd-run --user --scope --collect --quiet bash -c "exit 0" 2>/dev/null; then
        _scope_ok=1
    fi
    if [ "$_scope_ok" -eq 1 ]; then
        TMX_CLASSIFICATION="tmx-supported"
    else
        TMX_CLASSIFICATION="tmx-degraded"
    fi
else
    # Darwin: classification reflects rlimit availability.
    if command -v ulimit >/dev/null 2>&1 || builtin help ulimit >/dev/null 2>&1; then
        TMX_CLASSIFICATION="tmx-supported"
    else
        TMX_CLASSIFICATION="tmx-degraded"
    fi
fi
export TMX_CLASSIFICATION

# Apply oom_score_adj=-500 (Linux only; Darwin has no equivalent).
_apply_oom_score() {
    [ "$HOST_OS" = "Linux" ] || return 0
    local sock_label="$1"
    sleep 0.3
    local server_pid
    server_pid=$("$TMUX_BIN" -L "$sock_label" display-message -p '#{pid}' 2>/dev/null || true)
    [ -n "$server_pid" ] || return 0
    if [ -x "$OOM_HELPER" ]; then
        "$OOM_HELPER" "$server_pid" -500 >/dev/null 2>&1 || true
    elif [ "$(id -u)" = "0" ] && [ -w "/proc/$server_pid/oom_score_adj" ]; then
        echo -500 > "/proc/$server_pid/oom_score_adj" 2>/dev/null || true
    fi
}

# Resolve the effective color for a session. §102 per-session color.
# Args: <name> <inline_candidate>
# - if inline candidate non-empty: validate; on invalid, return code 5
#   (caller fails-fast, no session created); on valid, best-effort persist
#   via tmx-state-bin (non-fatal) and print it.
# - else: read persisted color (non-fatal if state binary absent); print it.
# - else: print nothing (caller falls back to hostname color).
# Non-fatal posture preserves the wrapper's "tmx-never-breaks" invariant.
_resolve_color() {
    name="$1"; cand="${2-}"
    if [ -n "$cand" ]; then
        if ! _color_valid "$cand"; then
            printf 'tmx: invalid color %s (use a tmux name, colour0-255, or #hex)\n' "$cand" >&2
            return 5
        fi
        if [ -x "$TMX_DIR/tmx-state-bin" ]; then
            "$TMX_DIR/tmx-state-bin" set-color "$name" "$cand" >/dev/null 2>&1 || true
        fi
        printf '%s' "$cand"
        return 0
    fi
    if [ -x "$TMX_DIR/tmx-state-bin" ]; then
        "$TMX_DIR/tmx-state-bin" get-color "$name" 2>/dev/null || true
    fi
    return 0
}

# Apply an explicit color to the 4 "green" surfaces (mirrors _apply_host_color
# minus the hostname derivation). Best-effort + silent on failure.
_apply_color() {
    sock_label="$1"; color="$2"
    "$TMUX_BIN" -L "$sock_label" set -g status-style                "bg=$color" 2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g pane-active-border-style    "fg=$color" 2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g clock-mode-colour           "$color"    2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g window-status-current-style "bg=$color,fg=black" 2>/dev/null || true
}

# Apply hostname-derived status-bar bg colour on the running server.
# On Darwin we prefer LocalHostName (e.g. "Mistborn") over the FQDN
# (e.g. "Mistborn.local") because that's what zsh's %m, the operator's
# prompts, and the prior bridge-era behaviour all show. This keeps the
# colour stable across "native" and "bridge" architectures.
_apply_host_color() {
    local sock_label="$1"
    sleep 0.3
    local hname=""
    if [ -n "${TMX_HOSTNAME:-}" ]; then
        hname="$TMX_HOSTNAME"
    elif [ "$HOST_OS" = "Darwin" ] && command -v scutil >/dev/null 2>&1; then
        hname=$(scutil --get LocalHostName 2>/dev/null || true)
    fi
    local color
    if [ -n "$hname" ]; then
        color=$("$TMX_DIR/hostname_color.sh" "$hname" 2>/dev/null) || color="green"
        # Propagate to tmux env so #{TMX_HOSTNAME} in status-right resolves.
        "$TMUX_BIN" -L "$sock_label" set-environment -g TMX_HOSTNAME "$hname" 2>/dev/null || true
    else
        color=$("$TMX_DIR/hostname_color.sh" 2>/dev/null) || color="green"
    fi
    # Apply the hostname-derived colour to every tmux UI element that
    # defaults to green (or inherits one that does). Operator mandate
    # (2026-05-21): "Do coloring of all UI tmux parts with proper color
    # we use instead of default green. Anything colored with that green
    # colors has to become the color we have assigned to the bottom
    # view we are coloring."
    #
    # tmux's default-green surfaces:
    #   1. status-style              bg=green (the bottom status bar)
    #   2. pane-active-border-style  fg=green (active pane's border)
    #   3. clock-mode-colour         green    (prefix+t clock face)
    #   4. window-status-current-style — inherits status-style.bg, but
    #      we set it explicitly so it doesn't drift if anyone overrides
    #      status-style elsewhere.
    #
    # mode-style (copy-mode banner) and message-style default to YELLOW,
    # not green, so they are NOT recoloured — keeping yellow there is
    # the most accessible contrast against any palette-derived bg.
    "$TMUX_BIN" -L "$sock_label" set -g status-style              "bg=$color" 2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g pane-active-border-style  "fg=$color" 2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g clock-mode-colour         "$color"    2>/dev/null || true
    "$TMUX_BIN" -L "$sock_label" set -g window-status-current-style "bg=$color,fg=black" 2>/dev/null || true
}

# Enumerate all of OUR sockets (active tmux servers we spawned).
_our_sockets() {
    local rt
    for rt in "${TMUX_TMPDIR:-}/tmux-$(id -u)" "/tmp/tmux-$(id -u)"; do
        [ -d "$rt" ] || continue
        ls -1 "$rt" 2>/dev/null | grep "^${TMX_SOCK_PREFIX}" || true
        return 0
    done
}

_list_all_sessions() {
    local sock
    while IFS= read -r sock; do
        [ -z "$sock" ] && continue
        "$TMUX_BIN" -L "$sock" ls 2>/dev/null || true
    done < <(_our_sockets)
}

# Ensure $TERM names a terminal that HAS a terminfo entry on this host before
# the inner per-session `tmux new-session` runs. tmux validates $TERM against
# the terminfo database on a real PTY and REFUSES to start its server with
# "missing or unsuitable terminal: <TERM>" when the entry is absent — the exact
# failure seen when tmx is launched from inside another tmux (the outer pane
# exports TERM=tmux-256color) on a host whose terminfo lacks that entry
# (minimal containers, nested-tmux, BSD bases). This is best-effort + honest:
# - if `infocmp` is unavailable we cannot probe, so leave $TERM untouched;
# - if the current $TERM resolves, leave it untouched (real interactive use
#   under a present TERM — xterm-256color etc. — is unaffected);
# - otherwise fall back to the first terminfo-PRESENT candidate and emit a
#   one-line stderr note so the substitution is never silent. §11.4.6/§11.4.111.
_ensure_terminfo_term() {
    command -v infocmp >/dev/null 2>&1 || return 0
    if infocmp "${TERM:-}" >/dev/null 2>&1; then
        return 0
    fi
    _eff_fallback=""
    for _eff_t in screen-256color xterm-256color screen xterm; do
        if infocmp "$_eff_t" >/dev/null 2>&1; then
            _eff_fallback="$_eff_t"
            break
        fi
    done
    if [ -n "$_eff_fallback" ]; then
        printf 'tmx: TERM=%s has no terminfo entry on this host; using %s for the session terminal.\n' \
            "${TERM:-<unset>}" "$_eff_fallback" >&2
        TERM="$_eff_fallback"
        export TERM
    fi
}

# Ensure the inner tmux finds the host's terminfo DATABASE. The shipped tmux is
# linked against a STATIC libtinfo whose compiled-in terminfo search path can be
# a build-time prefix that is ABSENT at runtime (§11.4.108) — so `tmux new` dies
# "can't find terminfo database" even though the host HAS the entry (forensic
# 2026-06-30: TERM=screen-256color present in /usr/share/terminfo, but the static
# tinfo searched only the gone .local-deps build prefix). ncurses consults
# $TERMINFO_DIRS (env) BEFORE its compiled-in default, so export the host's REAL
# terminfo dirs — as reported by the system `infocmp -D` (authoritative), else
# the conventional locations. Idempotent + honest (§11.4.6): an operator-set
# TERMINFO_DIRS is preserved (system dirs appended, not replaced); if no dir is
# found we leave the env untouched rather than invent one. §11.4.111.
_ensure_terminfo_dirs() {
    _etd_sys=""
    if command -v infocmp >/dev/null 2>&1; then
        _etd_sys="$(infocmp -D 2>/dev/null | tr '\n' ':' | sed 's/:*$//')"
    fi
    if [ -z "$_etd_sys" ]; then
        for _etd_d in /usr/share/terminfo /lib/terminfo /etc/terminfo /usr/lib/terminfo /run/current-system/sw/share/terminfo; do
            [ -d "$_etd_d" ] && _etd_sys="${_etd_sys:+$_etd_sys:}$_etd_d"
        done
    fi
    [ -n "$_etd_sys" ] || return 0
    if [ -n "${TERMINFO_DIRS:-}" ]; then
        TERMINFO_DIRS="${TERMINFO_DIRS}:${_etd_sys}"
    else
        TERMINFO_DIRS="$_etd_sys"
    fi
    export TERMINFO_DIRS
}
# Run at load so EVERY inner tmux invocation (new / attach / ls / kill) inherits
# the resolved TERMINFO_DIRS before the static-tinfo binary looks up the DB.
_ensure_terminfo_dirs

# Read a password from /dev/tty character-by-character, echoing '*' per
# keystroke instead of the real character (§2 mandate, 2026-07-05:
# passwords MUST NOT be visible to a naked eye while typing). Backspace/DEL
# erases the last '*' and the last buffered character. Terminates on
# Enter. Prints the collected password to stdout (NO trailing newline) —
# callers capture it via command substitution:
#   pw=$(_read_password_masked "prompt: ")
# Ctrl-D/EOF is treated as "done" with whatever was typed so far (possibly
# empty), matching the plain `read -r` EOF behaviour it replaces.
_read_password_masked() {
    local prompt="$1"
    local pw=""
    local char
    printf '%s' "$prompt" >/dev/tty
    while IFS= read -r -s -n1 char </dev/tty; do
        if [ -z "$char" ]; then
            break
        fi
        case "$char" in
            $'\x7f'|$'\x08')
                if [ -n "$pw" ]; then
                    pw="${pw%?}"
                    printf '\b \b' >/dev/tty
                fi
                continue
                ;;
        esac
        pw="${pw}${char}"
        printf '*' >/dev/tty
    done
    printf '\n' >/dev/tty
    printf '%s' "$pw"
}

# ── arg parsing ──────────────────────────────────────────────────────

SUBCMD=""
for a in "$@"; do
    case "$a" in
        -[a-zA-Z]*) ;;
        *) SUBCMD="$a"; break ;;
    esac
done

# AUDIT-2 fix (2026-05-21): the README/AGENTS commands table lists
# `tmx kill` as one of the friendly verbs ({new|attach|ls|kill}). tmux's
# own dispatcher rejects bare `kill` as ambiguous ("could be: kill-pane,
# kill-server, kill-session, kill-window"). The user-intent of `tmx kill
# -t NAME` is unambiguous: kill THIS session. Translate the bare verb to
# `kill-session` so the documented operator-path actually works. Does
# NOT intercept `kill-pane` / `kill-server` / `kill-session` /
# `kill-window` — those still pass through verbatim.
if [ "$SUBCMD" = "kill" ]; then
    SUBCMD="kill-session"
    # Rewrite "$@" so downstream `case "$SUBCMD" in kill-session)` sees the
    # translated verb. The bare `kill` was always the FIRST non-flag arg
    # per the SUBCMD discovery loop above.
    _new_args=()
    _replaced=0
    for a in "$@"; do
        if [ "$_replaced" -eq 0 ] && [ "$a" = "kill" ]; then
            _new_args+=("kill-session"); _replaced=1
        else
            _new_args+=("$a")
        fi
    done
    set -- "${_new_args[@]}"
fi

SESSION_ARG=""
TARGET_ARG=""
EXPLICIT_LABEL=""
i=0
for a in "$@"; do
    i=$((i+1))
    case "$a" in
        -s) eval "SESSION_ARG=\${$((i+1)):-}";;
        -t) eval "TARGET_ARG=\${$((i+1)):-}";;
        -L) eval "EXPLICIT_LABEL=\${$((i+1)):-}";;
    esac
done

RAW_NAME=""
[ -n "$SESSION_ARG" ] && RAW_NAME="$SESSION_ARG"
[ -z "$RAW_NAME" ] && [ -n "$TARGET_ARG" ] && RAW_NAME="$TARGET_ARG"
[ -z "$RAW_NAME" ] && RAW_NAME="default"

# §102 per-session color: split "name:color[:ignored]" on unescaped ':'.
if command -v _parse_session_value >/dev/null 2>&1; then
    _parse_session_value "$RAW_NAME"
else
    PARSED_NAME="$RAW_NAME"; PARSED_COLOR=""
fi
NAME=$(_sanitise "$PARSED_NAME")
# Resolve effective color (inline > persisted > "" → hostname fallback).
# Invalid inline color → exit 5 BEFORE any socket/scope/session is created.
EFFECTIVE_COLOR=""
_resolve_rc=0
if command -v _resolve_color >/dev/null 2>&1; then
    EFFECTIVE_COLOR=$(_resolve_color "$NAME" "$PARSED_COLOR") || _resolve_rc=$?
    if [ "${_resolve_rc:-0}" -eq 5 ]; then
        exit 5
    fi
fi

SAFE_NAME="$NAME"
SOCK_LABEL="${TMX_SOCK_PREFIX}${SAFE_NAME}"
SCOPE_UNIT="${TMX_SCOPE_PREFIX}${SAFE_NAME}.scope"

[ -n "$EXPLICIT_LABEL" ] && SOCK_LABEL="$EXPLICIT_LABEL"

# ── dispatch ─────────────────────────────────────────────────────────

# All-flag invocations (`tmx -V`, `tmx -h`) pass through.
if [ -z "$SUBCMD" ] && [ "$#" -gt 0 ] && [ "${1#-}" != "$1" ]; then
    exec "$TMUX_BIN" "$@"
fi

case "$SUBCMD" in
    new|new-session|start-server|"")
        # §11.4 cwd restore: query state daemon for last-known pwd of
        # this session. Falls back to $HOME if no record exists or if
        # the recalled path no longer exists on disk. Failure of the
        # state binary is non-fatal — wrapper preserves its tmx-never-
        # breaks invariant per spec §6 edge cases 6 / 7 / 11.
        LAST_PWD=""
        if [ -x "$TMX_DIR/tmx-state-bin" ]; then
            LAST_PWD=$("$TMX_DIR/tmx-state-bin" recall "$NAME" 2>/dev/null || true)
            # Validate the recalled path still exists and is a directory.
            if [ -n "$LAST_PWD" ] && [ ! -d "$LAST_PWD" ]; then
                printf '[tmx] last-pwd %s no longer exists for %s; using $HOME\n' "$LAST_PWD" "$NAME" >&2
                LAST_PWD=""
            fi
        fi
        # Final fallback: $HOME if nothing usable.
        START_DIR="${LAST_PWD:-$HOME}"

        # Collision check (Linux only — scope-based; Darwin uses socket
        # presence as the natural collision detector).
        if [ "$HOST_OS" = "Linux" ] && [ "$_scope_ok" -eq 1 ] && \
           systemctl --user is-active --quiet "$SCOPE_UNIT" 2>/dev/null; then
            echo "tmx: refusing to create session '$NAME' — scope $SCOPE_UNIT is already active." >&2
            echo "     run 'tmx kill-session -t $NAME' to release it, or pick a different name." >&2
            exit 4
        fi
        if [ "$HOST_OS" = "Darwin" ]; then
            # On Darwin, check if a server with this socket label is already up.
            if "$TMUX_BIN" -L "$SOCK_LABEL" ls 2>/dev/null | grep -q .; then
                echo "tmx: refusing to create session '$NAME' — server on socket $SOCK_LABEL is already running." >&2
                echo "     run 'tmx kill-session -t $NAME' to release it, or pick a different name." >&2
                exit 4
            fi
        fi

        # Fully-elastic ("liquid") memory (Constitution §105/§106): a session uses ALL
        # available RAM/zram and is NEVER per-scope OOM-killed. Default = no hard cap
        # (MemoryMax=infinity) + a small MemoryMin floor so it is not reclaimed to
        # death; genuine exhaustion is handled system-wide by systemd-oomd + zram + the
        # user-slice backstop (OOM-Protect). TMX_MEM adds an OPT-IN *soft* MemoryHigh
        # throttle (reclaim, never kill); TMX_MEM=auto uses the host-adaptive size.
        TMX_MEM_EFFECTIVE="${TMX_MEM:-}"
        [ "$TMX_MEM_EFFECTIVE" = auto ] && TMX_MEM_EFFECTIVE="$(_default_mem_mb)M"
        TMX_CPU_EFFECTIVE="${TMX_CPU:-200}"
        TMX_MEM_ARGS=( -p "MemoryMax=infinity" -p "MemoryMin=128M" )
        [ -n "$TMX_MEM_EFFECTIVE" ] && TMX_MEM_ARGS+=( -p "MemoryHigh=$TMX_MEM_EFFECTIVE" )

        INTERACTIVE=1
        for a in "$@"; do
            case "$a" in -d|-D) INTERACTIVE=0 ;; esac
        done

        # §11.4.111 wrapper robustness: make $TERM terminfo-valid for the inner
        # tmux server BEFORE we spawn it, so tmx works from inside a nested tmux
        # / minimal-terminfo host instead of dying with "missing or unsuitable
        # terminal". No-op when $TERM already resolves (normal interactive use).
        _ensure_terminfo_term

        # §11.4.108 runtime signature plumbing: capture the inner create's
        # stderr so that, if the server fails to come up, we can surface tmux's
        # OWN error (e.g. the terminal-type message) instead of silently
        # `exec attach`-ing onto a dead server. Per-command 2> redirect bypasses
        # the global libtinfo-filter on fd2 so the real error is preserved.
        CREATE_ERR="${TMUX_TMPDIR:-/tmp}/.tmx-create-err.$$"
        : > "$CREATE_ERR" 2>/dev/null || CREATE_ERR="/dev/null"

        # ── PER-OS ISOLATION ────────────────────────────────────────
        case "$HOST_OS" in
            Linux)
                # Build the tmux invocation. -L SOCK_LABEL pins this
                # session to its own socket. -f loads our tmux.conf.
                TMUX_CONF="$TMX_DIR/tmux.conf.template"
                NEW_ARGS=("-L" "$SOCK_LABEL")
                if [ -f "$TMUX_CONF" ]; then
                    NEW_ARGS+=("-f" "$TMUX_CONF")
                fi
                SAW_NEW=0
                SAW_C=0
                # §11.4.111 by-stable-name: the value following `-s` is the RAW
                # "name[:color[:ignored]]" / escaped-colon token. tmux derives
                # its actual session name from whatever we pass to `-s`, while
                # the socket label, the has-session check below, the color
                # application, and the state record all key off the SANITISED
                # $NAME. Passing the raw value through (the prior bug) made
                # tmux name the session from the raw string — tmux maps ':'→'_'
                # and KEEPS a literal backslash, so `t63w6\:x:cyan` became
                # session `t63w6\_x_cyan`, which the sanitised NAME `t63w6_x`
                # neither equals nor prefix-matches → has-session FAILS → the
                # color step never runs (the §102 escaped-colon defect). Simple
                # cases (`t63w1:red` → tmux `t63w1_red`) only "passed" because
                # NAME prefix-matched. Rewrite the `-s` value to $NAME so tmux's
                # session name == the wrapper's NAME exactly (Darwin already
                # passes -s "$NAME"; this brings Linux into parity).
                _prev=""
                for a in "$@"; do
                    case "$a" in -L) _prev="$a"; continue ;; esac
                    if [ "$_prev" = "-s" ]; then
                        NEW_ARGS+=("$NAME")
                        _prev="$a"
                        continue
                    fi
                    NEW_ARGS+=("$a")
                    case "$a" in
                        new|new-session|start-server)
                            if [ "$INTERACTIVE" -eq 1 ] && [ "$SAW_NEW" -eq 0 ]; then
                                NEW_ARGS+=("-d")
                                SAW_NEW=1
                            elif [ "$SAW_NEW" -eq 0 ]; then
                                # Operator passed -d explicitly; mark
                                # SAW_NEW so we don't re-synthesise.
                                SAW_NEW=1
                            fi
                            ;;
                        -c) SAW_C=1 ;;
                    esac
                    _prev="$a"
                done
                # §11.4 cwd restore (Linux): if `new` was passed but no
                # explicit `-c <path>`, inject `-c $START_DIR` so the
                # spawned pane starts in the recalled last-pwd. Honours
                # operator-passed `-c` (SAW_C=1) by leaving NEW_ARGS as-is.
                if [ "$SAW_NEW" -eq 1 ] && [ "$SAW_C" -eq 0 ]; then
                    NEW_ARGS+=("-c" "$START_DIR")
                fi
                # Fallback synthesise when no `new` token at all (operator
                # invoked `tmx -s NAME` style); same shape as before.
                if [ "$SAW_NEW" -eq 0 ] && [ "$INTERACTIVE" -eq 1 ]; then
                    NEW_ARGS=("-L" "$SOCK_LABEL" "-f" "$TMUX_CONF" "new-session" "-d" "-s" "$NAME" "-c" "$START_DIR")
                    SAW_NEW=1
                fi

                if [ "$_scope_ok" -eq 1 ]; then
                    systemd-run --user --scope --quiet \
                        --unit="$SCOPE_UNIT" \
                        "${TMX_MEM_ARGS[@]}" \
                        -p "CPUQuota=${TMX_CPU_EFFECTIVE}%" \
                        -p "TasksMax=4096" \
                        -p "Delegate=yes" \
                        "$TMUX_BIN" "${NEW_ARGS[@]}" 2>"$CREATE_ERR"
                else
                    "$TMUX_BIN" "${NEW_ARGS[@]}" 2>"$CREATE_ERR"
                fi
                ;;

            Darwin)
                # On Darwin we have no cgroups. We use POSIX rlimit
                # wrapper as the session's initial command, which sets
                # RLIMIT_AS/CPU/NPROC before exec'ing the user's shell.
                # All processes spawned from that shell inherit the
                # limits. Resource caps are kernel-enforced; the shell
                # sees the full host environment otherwise.
                TMUX_CONF="$TMX_DIR/tmux.conf.template"

                # Convert MemoryMax to KB for ulimit -v.
                MEM_BYTES=$(printf '%s' "$TMX_MEM_EFFECTIVE" | awk '
                    /[Gg]$/ {sub(/[Gg]$/,""); print $0 * 1024 * 1024 * 1024; exit}
                    /[Mm]$/ {sub(/[Mm]$/,""); print $0 * 1024 * 1024;        exit}
                    /[Kk]$/ {sub(/[Kk]$/,""); print $0 * 1024;               exit}
                    {print $0; exit}')
                MEM_KB=$(( MEM_BYTES / 1024 ))

                # CPU time soft limit: TMX_CPU_HARD_SEC env or 24h default.
                CPU_SEC="${TMX_CPU_HARD_SEC:-86400}"
                # Per-user process count (RLIMIT_NPROC is per-user on Darwin).
                PROC_MAX="${TMX_PROC_MAX:-4096}"

                USER_SHELL="${SHELL:-/bin/zsh}"

                # tmux session command is the rlimit wrapper around the
                # user's shell. The wrapper applies caps and exec's the
                # shell.
                SESSION_CMD="$RLIMIT_WRAPPER $MEM_KB $CPU_SEC $PROC_MAX $USER_SHELL -l"

                # §11.4 cwd restore: -c $START_DIR makes tmux spawn the
                # new session's initial pane in the recalled cwd. tmux's
                # arg order is `-c <dir>` before the trailing command.
                if [ "$INTERACTIVE" -eq 1 ]; then
                    "$TMUX_BIN" -L "$SOCK_LABEL" -f "$TMUX_CONF" new-session -d -s "$NAME" -c "$START_DIR" "$SESSION_CMD" 2>"$CREATE_ERR"
                else
                    "$TMUX_BIN" -L "$SOCK_LABEL" -f "$TMUX_CONF" new-session -d -s "$NAME" -c "$START_DIR" "$SESSION_CMD" 2>"$CREATE_ERR"
                fi

                # Also wrap default-command so :new-window / :split-window
                # spawn shells with the same rlimits applied.
                "$TMUX_BIN" -L "$SOCK_LABEL" set -g default-command "$SESSION_CMD" 2>/dev/null || true
                ;;
        esac

        # §11.4.108 runtime signature: the inner `tmux new-session` ran under
        # `set -u` (NOT `set -e`), so a create failure does NOT abort the
        # wrapper. WITHOUT this check the wrapper would carry on to the password
        # prompt and then `exec attach` onto a server that never came up — a
        # SILENT failure the operator only sees as "attach hangs / no session"
        # (the §11.4 bluff this fixes). Verify the server is actually up BEFORE
        # any further work; on failure surface tmux's OWN error + exit non-zero.
        if ! "$TMUX_BIN" -L "$SOCK_LABEL" has-session -t "$NAME" 2>/dev/null; then
            printf 'tmx: failed to create session "%s" — the tmux server did not come up.\n' "$NAME" >&2
            if [ "$CREATE_ERR" != "/dev/null" ] && [ -s "$CREATE_ERR" ]; then
                printf 'tmx: tmux reported:\n' >&2
                sed 's/^/      /' "$CREATE_ERR" >&2 2>/dev/null || cat "$CREATE_ERR" >&2
            fi
            printf 'tmx: (TERM=%s — ensure the terminal type has a terminfo entry, or that the build is intact)\n' "${TERM:-<unset>}" >&2
            [ "$CREATE_ERR" != "/dev/null" ] && rm -f "$CREATE_ERR" 2>/dev/null || true
            exit 1
        fi
        [ "$CREATE_ERR" != "/dev/null" ] && rm -f "$CREATE_ERR" 2>/dev/null || true

        _apply_oom_score "$SOCK_LABEL"
        if [ -n "$EFFECTIVE_COLOR" ]; then
            _apply_color "$SOCK_LABEL" "$EFFECTIVE_COLOR"
        else
            _apply_host_color "$SOCK_LABEL"
        fi

        # §11.4 cwd capture: install tmux hooks that fire `tmx-state
        # record` on client-detached and session-closed, persisting the
        # current pane's cwd so the next `tmx new -s NAME` can restore
        # it. The OUTER quoting is single-quoted so #{pane_current_path}
        # is passed verbatim to tmux for FORMAT expansion at hook time.
        # `$NAME` is sanitised upstream; embedding it inside the run-
        # shell string is safe for the sanitised token set
        # ([A-Za-z0-9._-]) per `_sanitise` above.
        if [ -x "$TMX_DIR/tmx-state-bin" ]; then
            HOOK_CMD="run-shell '$TMX_DIR/tmx-state-bin record $NAME #{pane_current_path}'"
            "$TMUX_BIN" -L "$SOCK_LABEL" set-hook -g client-detached "$HOOK_CMD" 2>/dev/null || true
            "$TMUX_BIN" -L "$SOCK_LABEL" set-hook -g session-closed  "$HOOK_CMD" 2>/dev/null || true
        fi

        # ── clause 6: idle-timeout session recycler ─────────────────────
        # Launch a per-session external watcher (scripts/tmx-recycler.sh)
        # that recycles this session after it has had NO client attached for
        # >= TMX_RECYCLE_IDLE_SECS (default 900). The watcher tears the
        # runtime down (kill-session + Linux scope-stop) WITHOUT clearing
        # state, so last_pwd / color / password persist for a later
        # `tmx new -s NAME`. TMX_RECYCLE_IDLE_SECS=0 disables it (per-session
        # opt-out for intentionally long-lived detached sessions). Singleton
        # per session (§11.4.119); backgrounded + disowned (§11.4.89) so it
        # survives the `exec attach` below. The watcher is the SAME on Linux
        # and macOS (only the teardown's scope-stop step is Linux-only).
        TMX_RECYCLE_WINDOW="${TMX_RECYCLE_IDLE_SECS:-900}"
        RECYCLER="$TMX_DIR/tmx-recycler.sh"
        MARKER_DIR="${TMUX_TMPDIR:-/tmp}/tmx-recycler-$(id -u)"
        MARKER_PATH="$MARKER_DIR/${SAFE_NAME}.detached"
        if [ -f "$RECYCLER" ] && [ "$TMX_RECYCLE_WINDOW" != "0" ]; then
            mkdir -p "$MARKER_DIR" 2>/dev/null || true
            # Marker hooks: write the detach-since epoch on client-detached
            # (appended via -ga so the existing cwd-record hook still runs),
            # and CLEAR it on client-attached (cancel-on-attach race-guard).
            # A quick `printf`/`rm` is sub-second, so it does NOT block the
            # tmux command queue the way `run-shell 'sleep'` would.
            DET_CMD="run-shell 'bash $RECYCLER detached $MARKER_PATH'"
            ATT_CMD="run-shell 'bash $RECYCLER attached $MARKER_PATH'"
            "$TMUX_BIN" -L "$SOCK_LABEL" set-hook -ga client-detached "$DET_CMD" 2>/dev/null || true
            "$TMUX_BIN" -L "$SOCK_LABEL" set-hook -g  client-attached "$ATT_CMD" 2>/dev/null || true
            # Background the watcher (§11.4.89). Config passed via env.
            TMX_RC_TMUX_BIN="$TMUX_BIN" \
            TMX_RC_SOCK="$SOCK_LABEL" \
            TMX_RC_NAME="$NAME" \
            TMX_RC_SCOPE="$SCOPE_UNIT" \
            TMX_RC_STATE_BIN="$TMX_DIR/tmx-state-bin" \
            TMX_RC_WINDOW="$TMX_RECYCLE_WINDOW" \
            TMX_RC_MARKER="$MARKER_PATH" \
            TMX_RC_HOST_OS="$HOST_OS" \
                nohup bash "$RECYCLER" watch >/dev/null 2>&1 &
            disown 2>/dev/null || true
        fi

        # Propagate TMX_HOSTNAME for status-bar conditional.
        if [ -n "${TMX_HOSTNAME:-}" ]; then
            "$TMUX_BIN" -L "$SOCK_LABEL" set-environment -g TMX_HOSTNAME "$TMX_HOSTNAME" 2>/dev/null || true
        fi

        # §1 session password: prompt optionally, store if non-empty.
        # Only on interactive sessions (not -d). Silent + non-fatal if the
        # state binary is absent or fails.
        if [ "$INTERACTIVE" -eq 1 ] && [ -t 0 ]; then
            PASSWORD=$(_read_password_masked "[tmx] Enter password for session \"$NAME\" (blank = none): ")
            if [ -n "$PASSWORD" ] && [ -x "$TMX_DIR/tmx-state-bin" ]; then
                "$TMX_DIR/tmx-state-bin" set-password "$NAME" "$PASSWORD" >/dev/null 2>&1 || true
            fi
            unset PASSWORD
        fi

        if [ "$INTERACTIVE" -eq 1 ]; then
            exec "$TMUX_BIN" -L "$SOCK_LABEL" attach -t "$NAME"
        fi
        ;;

    ls|list-sessions)
        _list_all_sessions
        ;;

    kill-server)
        while IFS= read -r sock; do
            [ -z "$sock" ] && continue
            "$TMUX_BIN" -L "$sock" kill-server 2>/dev/null || true
            if [ "$HOST_OS" = "Linux" ]; then
                local_scope="${TMX_SCOPE_PREFIX}${sock#${TMX_SOCK_PREFIX}}.scope"
                systemctl --user stop "$local_scope" 2>/dev/null || true
            fi
        done < <(_our_sockets)
        ;;

    kill-session)
        "$TMUX_BIN" -L "$SOCK_LABEL" kill-session -t "$NAME" 2>/dev/null || true
        if [ "$HOST_OS" = "Linux" ]; then
            systemctl --user stop "$SCOPE_UNIT" 2>/dev/null || true
        fi
        ;;

    delete)
        # clause 7: kill the session if alive AND clear its persisted state
        # so a fresh `tmx new -s NAME` starts from defaults (host-fallback
        # color, $HOME dir, fresh password prompt). This is the ONLY verb
        # that clears state — kill-session and the idle recycler PRESERVE it.
        # 1. Tear down the runtime (reuse the kill-session teardown path).
        "$TMUX_BIN" -L "$SOCK_LABEL" kill-session -t "$NAME" 2>/dev/null || true
        if [ "$HOST_OS" = "Linux" ]; then
            systemctl --user stop "$SCOPE_UNIT" 2>/dev/null || true
        fi
        # 2. Tidy the recycler's transient marker + singleton lock for this
        #    session. The watcher self-exits on its next poll once its
        #    session is gone; this just removes the leftover files now.
        _RC_DIR="${TMUX_TMPDIR:-/tmp}/tmx-recycler-$(id -u)"
        rm -f  "$_RC_DIR/${SAFE_NAME}.detached" 2>/dev/null || true
        rm -rf "$_RC_DIR/${SAFE_NAME}.lock"     2>/dev/null || true
        # 3. Clear persisted last_pwd + color + password_hash. `forget`
        #    deletes the whole session record, so all three are cleared.
        if [ -x "$TMX_DIR/tmx-state-bin" ]; then
            "$TMX_DIR/tmx-state-bin" forget "$NAME" >/dev/null 2>&1 || true
        fi
        ;;

    attach|attach-session|a)
        # §1 session password guard: if the session has a password, verify
        # it before allowing attach. Only prompts on interactive TTYs.
        # Non-fatal if the state binary is absent (graceful degradation).
        if [ -x "$TMX_DIR/tmx-state-bin" ] && [ -t 0 ]; then
            # Probe: does a password exist for this session? If the session
            # record doesn't exist (exit 2), skip — no guard.
            if "$TMX_DIR/tmx-state-bin" verify-password "$NAME" "" >/dev/null 2>&1; then
                : # No password set — can attach freely.
            else
                # Password exists (exit 1) or state readable (exit 0 with attempt).
                # Try an empty check again properly: if it returned non-zero AND
                # the session exists in state (exit != 2), a password is set.
                "$TMX_DIR/tmx-state-bin" verify-password "$NAME" "" 2>/dev/null
                rc=$?
                if [ "$rc" -eq 1 ]; then
                    # Password IS set — prompt for it.
                    printf '[tmx] Session "%s" is password-protected. Enter password: ' "$NAME" >/dev/tty
                    IFS= read -r PASSWORD </dev/tty
                    if ! "$TMX_DIR/tmx-state-bin" verify-password "$NAME" "$PASSWORD" >/dev/null 2>&1; then
                        printf '[tmx] Incorrect password for session "%s".\n' "$NAME" >&2
                        unset PASSWORD
                        exit 1
                    fi
                    unset PASSWORD
                fi
            fi
        fi
        # Re-apply the shipped config into the session BEFORE attaching, so
        # attaching to a PRE-EXISTING session (e.g. a long-running session, or
        # one created before a config update) always gets the current bindings
        # — mouse select/copy, paste, etc. A tmux server loads its config only
        # at start, so without this an old session keeps stale bindings even
        # after the operator re-opens it via the shell-init prompt. Forensic
        # anchor: user report 2026-05-29 (select/copy "not possible" when
        # re-attaching a session predating the mouse-copy fix). Non-fatal +
        # silent if the session/config is absent.
        TMUX_CONF_ATTACH="$TMX_DIR/tmux.conf.template"
        [ -f "$TMUX_CONF_ATTACH" ] && "$TMUX_BIN" -L "$SOCK_LABEL" source-file "$TMUX_CONF_ATTACH" 2>/dev/null || true
        # §102: re-apply a persisted/explicit color on attach so a
        # pre-existing session reflects its color. Non-fatal + silent.
        if [ -n "${EFFECTIVE_COLOR:-}" ]; then
            _apply_color "$SOCK_LABEL" "$EFFECTIVE_COLOR"
        fi
        exec "$TMUX_BIN" -L "$SOCK_LABEL" "$@"
        ;;

    reload)
        # Re-apply the shipped tmux.conf into RUNNING sessions so config
        # changes (updated mouse/copy/paste bindings, etc.) take effect
        # WITHOUT killing the session or losing pane content. A tmux server
        # loads its config only once at start, so long-running sessions keep
        # stale bindings until reloaded — this is exactly why a just-updated
        # mouse-copy fix appeared "not working" in a session started before
        # the update (forensic anchor: user report 2026-05-29).
        #   tmx reload            → reload EVERY running tmx session
        #   tmx reload -t NAME    → reload only session NAME
        TMUX_CONF="$TMX_DIR/tmux.conf.template"
        if [ ! -f "$TMUX_CONF" ]; then
            echo "tmx: config $TMUX_CONF not found" >&2
            exit 1
        fi
        if [ -n "$TARGET_ARG" ]; then
            if "$TMUX_BIN" -L "$SOCK_LABEL" source-file "$TMUX_CONF" 2>/dev/null; then
                echo "tmx: reloaded config into session '$NAME'"
            else
                echo "tmx: no running session '$NAME' to reload" >&2
                exit 1
            fi
        else
            _reloaded_any=0
            while IFS= read -r sock; do
                [ -z "$sock" ] && continue
                # Skip dead socket FILES (server already exited) — only reload
                # sockets with a live server, so a tree of stale socket files
                # left by prior runs does not slow or noise the reload.
                "$TMUX_BIN" -L "$sock" has-session 2>/dev/null || continue
                if "$TMUX_BIN" -L "$sock" source-file "$TMUX_CONF" 2>/dev/null; then
                    echo "tmx: reloaded ${sock#${TMX_SOCK_PREFIX}}"
                    _reloaded_any=1
                fi
            done < <(_our_sockets)
            [ "$_reloaded_any" -eq 1 ] || echo "tmx: no running tmx sessions to reload"
        fi
        ;;

    *)
        if [ -n "$TARGET_ARG" ]; then
            exec "$TMUX_BIN" -L "$SOCK_LABEL" "$@"
        elif [ -n "$EXPLICIT_LABEL" ]; then
            exec "$TMUX_BIN" "$@"
        else
            FIRST_SOCK=$(_our_sockets | head -1)
            if [ -n "$FIRST_SOCK" ]; then
                exec "$TMUX_BIN" -L "$FIRST_SOCK" "$@"
            else
                exec "$TMUX_BIN" "$@"
            fi
        fi
        ;;
esac
