#!/usr/bin/env bash
# tmx — macOS host bridge for the vasic-digital optimized tmux.
#
# The verified Linux ELF binary runs only inside the podman machine VM
# (Fedora CoreOS + systemd 257, where cgroup-v2 transient scopes, jemalloc,
# OOM helper, and the hostname-colour wrapper all work as designed).
#
# This bridge dispatches host invocations of `tmx <args>` into the VM via
# raw `ssh -t` (TTY allocation — required for interactive tmux). It uses
# `podman machine inspect` to discover the SSH endpoint at every call so
# port changes on machine restart don't break the bridge.
#
# Side-by-side coexistence is preserved: the system `tmux` command on the
# macOS host is untouched and reachable from PATH as usual.
#
# Generated by scripts/setup.sh on __DATE__ — DO NOT edit by hand.
# Re-run setup to regenerate with refreshed paths.

set -uo pipefail

VM_REPO="__VM_REPO__"
VM_WRAPPER="$VM_REPO/scripts/tmx-vm"

if ! command -v podman >/dev/null 2>&1; then
    echo "tmx: podman not installed — the bridge requires podman machine on macOS." >&2
    echo "     install via: brew install podman" >&2
    exit 2
fi

if ! podman machine list --format '{{.LastUp}}' 2>/dev/null | grep -qi "currently running"; then
    echo "tmx: podman machine is not running — start it with: podman machine start" >&2
    exit 2
fi

# Discover SSH endpoint dynamically (port may change across machine restarts).
SSH_IDENTITY=$(podman machine inspect --format '{{.SSHConfig.IdentityPath}}' 2>/dev/null)
SSH_PORT=$(podman machine inspect --format '{{.SSHConfig.Port}}' 2>/dev/null)
SSH_USER=$(podman machine inspect --format '{{.SSHConfig.RemoteUsername}}' 2>/dev/null)
if [ -z "$SSH_IDENTITY" ] || [ -z "$SSH_PORT" ] || [ -z "$SSH_USER" ]; then
    echo "tmx: could not read SSH config from 'podman machine inspect' — bridge cannot dispatch." >&2
    exit 2
fi

# Verify the VM-side wrapper is present (was regenerated for VM paths by
# `bash scripts/setup.sh` and/or `bash scripts/test_vm.sh`).
if ! ssh -i "$SSH_IDENTITY" -p "$SSH_PORT" \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        "$SSH_USER@127.0.0.1" "test -x $VM_WRAPPER" 2>/dev/null; then
    echo "tmx: VM-side wrapper $VM_WRAPPER not present or not executable." >&2
    echo "     run: bash scripts/setup.sh   (regenerates the VM wrapper)" >&2
    exit 3
fi

# Forward the host's hostname so the status-bar colour reflects MAC's
# identity (e.g., "Mistborn"), not the VM's generic `localhost.localdomain`.
# Per the user-mandated invariant: same Mac → same colour across every
# tmx session that runs from it.
HOST_HOSTNAME=$(hostname 2>/dev/null || echo "")
# Prefer the LocalHostName (Bonjour-style "Mistborn") over the FQDN when
# available; matches what shells like zsh's %m show in prompts.
if command -v scutil >/dev/null 2>&1; then
    LOCAL_HN=$(scutil --get LocalHostName 2>/dev/null || true)
    [ -n "$LOCAL_HN" ] && HOST_HOSTNAME="$LOCAL_HN"
fi

# Build the remote command. `printf %q` quotes each arg safely for the
# remote shell — works in bash 3.2+ (macOS default).
REMOTE_CMD="TMX_HOSTNAME=$(printf %q "$HOST_HOSTNAME") $VM_WRAPPER"
for arg in "$@"; do
    REMOTE_CMD="$REMOTE_CMD $(printf %q "$arg")"
done

exec ssh -t -i "$SSH_IDENTITY" -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    "$SSH_USER@127.0.0.1" "$REMOTE_CMD"
