#!/bin/sh
# tmx-shell-init — sourced from .bashrc/.zshrc to drive interactive tmx session selection
# Project: vasic-digital tmux (https://github.com/vasic-digital/tmux)
# Generated from scripts/tmx-shell-init.sh.template by scripts/setup.sh on __DATE__
# Documentation: docs/guides/tmx-shell-integration.md
# §11.4.67 — POSIX-parseable (sh -n clean), works under bash 3.2/5+, zsh, dash
#
# Behaviour contract (see docs/superpowers/specs/2026-05-22-tmx-shell-session-resume-design.md §4.A, §5, §6):
#   - $TMUX set                      → silent return 0 (already inside tmux)
#   - non-TTY stdin/stdout           → silent return 0 (scp/rsync/IDE pipes)
#   - $TMX_SKIP non-empty            → silent return 0 (operator override)
#   - `tmx` not on PATH              → silent return 0 (graceful degradation)
#   - empty or `default` input       → return 0 (bare shell)
#   - invalid session name           → stderr error + return 1
#   - valid name                     → exec `tmx attach -t NAME` || exec `tmx new -s NAME`
#
# Project: __PROJECT__

# Already inside a tmux session: install a PROMPT_COMMAND / precmd hook that
# records the current pane's $PWD to tmx-state on every shell prompt. This
# is the SOLE reliable mechanism for cwd persistence — tmux's session-end
# hooks (client-detached, session-closed) fire AFTER the pane is destroyed
# and `#{pane_current_path}` resolves to empty at that point (forensic
# anchor: user report 2026-05-22, fix landed v1.0.13). With this hook,
# every command the operator runs leaves the cwd recorded; the LAST
# recorded value before `exit` is the state that the NEXT `tmx new -s
# NAME` recalls via the wrapper's `-c $START_DIR` injection.
if [ -n "${TMUX:-}" ]; then
    # Where the wrapper + Go binary live.
    _tmx_dir="${VDIGITAL_TMUX_DIR:-__PROJECT__/scripts}"
    _tmx_state_bin="$_tmx_dir/tmx-state-bin"
    if [ -x "$_tmx_state_bin" ]; then
        # Resolve session name via tmux (#S = active session). More
        # reliable than env-var propagation — works even if the wrapper
        # didn't `set-environment` for any reason.
        #
        # CRITICAL: resolve the PROJECT's own tmux binary, NOT bare `tmux` on
        # PATH. The wrapper starts a hardened 3.6a server; if a DIFFERENT system
        # tmux is first on PATH (e.g. an OS-packaged 3.4) it speaks an
        # incompatible client protocol and `tmux display-message` returns
        # "server exited unexpectedly" → empty session name → the cwd-persist
        # hook silently never installs and the feature is DEAD for the operator
        # — while a dev host whose system tmux happens to be 3.6a passes green
        # (forensic anchor: thinker host, system tmux 3.4 vs 3.6a server,
        # 2026-06-28; §11.4.111 resolve-by-stable-identity-not-ambient-PATH +
        # §11.4.108 green-on-dev-host-dead-on-clean-target). setup.sh substitutes
        # __TMUX_BIN__ with the built binary's absolute path (the same value it
        # injects into scripts/tmx); the build-dir fallbacks keep the raw,
        # un-substituted template working, and bare `tmux` remains the last
        # resort. POSIX-only ([ -x ], ||, $()) — sh -n clean per §11.4.67.
        _tmx_tmux="__TMUX_BIN__"
        [ -x "$_tmx_tmux" ] || _tmx_tmux="$_tmx_dir/../tmux/build/bin/tmux"
        [ -x "$_tmx_tmux" ] || _tmx_tmux="$_tmx_dir/../tmux/build-darwin/bin/tmux"
        [ -x "$_tmx_tmux" ] || _tmx_tmux="$(command -v tmux 2>/dev/null)"
        _tmx_sess="$("$_tmx_tmux" display-message -p '#S' 2>/dev/null)" || _tmx_sess=""
        # Reject names with shell-meta chars (defense in depth — tmx
        # wrapper already sanitises, but tmux's session list could in
        # theory contain hand-renamed names).
        case "$_tmx_sess" in
            ''|*[!A-Za-z0-9_.-]*) _tmx_sess="" ;;
        esac
        if [ -n "$_tmx_sess" ]; then
            # Bash: idempotent append to PROMPT_COMMAND.
            if [ -n "${BASH_VERSION:-}" ]; then
                # The recorder runs once per prompt. Errors swallowed so
                # a broken state-file never breaks the operator's prompt.
                # Eval is used because we need to inject the session name
                # literal AT INSTALL TIME (the env var is local to this
                # source, not persisted to PROMPT_COMMAND's run context).
                _tmx_marker="_tmx_record_pwd_${_tmx_sess}"
                if ! type "$_tmx_marker" >/dev/null 2>&1; then
                    eval "${_tmx_marker}() { \"$_tmx_state_bin\" record \"$_tmx_sess\" \"\$PWD\" >/dev/null 2>&1 || true; }"
                fi
                case ";${PROMPT_COMMAND:-};" in
                    *";${_tmx_marker};"*) ;;
                    *) PROMPT_COMMAND="${_tmx_marker}${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
                esac
                export PROMPT_COMMAND
            # Zsh: append to precmd_functions array.
            elif [ -n "${ZSH_VERSION:-}" ]; then
                TMX_PROMPT_SESS="$_tmx_sess"
                export TMX_PROMPT_SESS
                _tmx_zsh_precmd() {
                    "$_tmx_state_bin" record "$TMX_PROMPT_SESS" "$PWD" >/dev/null 2>&1 || true
                }
                # Idempotent registration in zsh's hook array.
                # shellcheck disable=SC2154
                typeset -ga precmd_functions 2>/dev/null
                # Remove any prior _tmx_zsh_precmd, then re-add.
                # zsh-only array filter syntax — guarded by ZSH_VERSION above.
                eval 'precmd_functions=(${precmd_functions:#_tmx_zsh_precmd})'
                eval 'precmd_functions+=(_tmx_zsh_precmd)'
            fi
            # Capture cwd ONCE right now so even a zero-command session
            # (operator opens tmx + immediately exits) records a real
            # path instead of leaving stale recall state.
            "$_tmx_state_bin" record "$_tmx_sess" "$PWD" >/dev/null 2>&1 || true
        fi
    fi
    return 0 2>/dev/null || exit 0
fi

# Non-interactive shell (scp, rsync, IDE pipe, cron) — do not prompt.
# Distinctive marker (opt-in via TMX_INIT_DEBUG=1) so test 49 can assert this
# branch fired. Without the marker, P5-M20 (strip guard) cannot be distinguished
# from the legitimate empty-output path. End users never see the marker unless
# they set the env var.
if [ ! -t 0 ] || [ ! -t 1 ]; then
    [ -n "${TMX_INIT_DEBUG:-}" ] && printf 'tmx-shell-init: non-TTY guard fired (stdin/stdout not a TTY) — skipping interactive prompt\n' >&2
    return 0 2>/dev/null || exit 0
fi

# Operator opt-out.
if [ -n "${TMX_SKIP:-}" ]; then
    return 0 2>/dev/null || exit 0
fi

# Wrapper absent — graceful degradation, no prompt, bare shell.
if ! command -v tmx >/dev/null 2>&1; then
    return 0 2>/dev/null || exit 0
fi

# Per-process idempotency guard. A single shell PROCESS can source this
# script more than once — notably bash LOGIN shells where .bash_profile
# carries the tmx-shell-init source line AND sources .bashrc, which carries
# it too (forensic anchor: nezha `bash -l -i` double-prompt, user report
# 2026-05-29, reproduced PROMPT_COUNT=2). The blank/`default` path below
# RETURNS (it does not exec), so .bash_profile then continues, sources
# .bashrc, and the SECOND source re-prompts — "asked twice in a row". A
# NON-exported marker persists across sources WITHIN this process but resets
# for each NEW shell process, so every new terminal still prompts exactly
# once. Fixed at the source layer here, never at the rc call sites (§11.4.1).
if [ -n "${_TMX_SHELL_INIT_PROMPTED:-}" ]; then
    return 0 2>/dev/null || exit 0
fi
_TMX_SHELL_INIT_PROMPTED=1

# Prompt + read. printf, not echo -e (POSIX).
printf '[tmx] Enter session name to create (blank = choose existing session): ' >&2
# shellcheck disable=SC2034  # session_name read below
session_name=''
if ! IFS= read -r session_name; then
    # EOF or read error — fall through to bare shell.
    return 0 2>/dev/null || exit 0
fi

# Empty input or literal `default` → offer a choice: join an existing
# session by number, or leave the wizard (bare shell). §4 mandate
# (2026-07-05): blank input is no longer an automatic bare shell when
# sessions already exist — the operator gets a picker instead.
if [ -z "$session_name" ] || [ "$session_name" = "default" ]; then
    _existing="$(tmx ls 2>/dev/null | sed -n 's/^\([^:]*\):.*/\1/p')"
    if [ -z "$_existing" ]; then
        # No existing sessions to offer — unchanged default: bare shell.
        return 0 2>/dev/null || exit 0
    fi
    printf '[tmx] Existing sessions:\n' >&2
    _n=0
    _tmx_menu_names=""
    for _s in $_existing; do
        _n=$((_n + 1))
        printf '  %d) %s\n' "$_n" "$_s" >&2
        _tmx_menu_names="${_tmx_menu_names}${_s} "
    done
    printf '  0) None (leave, bare shell)\n' >&2
    _attempt=0
    _valid=0
    _choice=''
    while [ "$_attempt" -lt 2 ] && [ "$_valid" -eq 0 ]; do
        if [ "$_attempt" -eq 0 ]; then
            printf '[tmx] Choose a session to join (0 = none): ' >&2
        else
            printf '[tmx] invalid choice; try again (0 = none): ' >&2
        fi
        IFS= read -r _choice
        case "$_choice" in
            ''|0) break ;;
            *[!0-9]*) ;;
            *) if [ "$_choice" -ge 1 ] && [ "$_choice" -le "$_n" ]; then _valid=1; fi ;;
        esac
        _attempt=$((_attempt + 1))
    done
    if [ "$_valid" -eq 1 ]; then
        _picked=""
        _i=0
        for _s in $_tmx_menu_names; do
            _i=$((_i + 1))
            if [ "$_i" -eq "$_choice" ]; then
                _picked="$_s"
                break
            fi
        done
        if [ -n "$_picked" ]; then
            exec sh -c 'exec tmx attach -t "$1"' tmx-shell-init "$_picked"
        fi
    fi
    return 0 2>/dev/null || exit 0
fi

# Validate via POSIX case (NOT bash-only [[ =~ ]]).
# Allowed: [A-Za-z0-9_.-:#]{1,80} — ':' separates inline color per §5.8;
# '#' permits #hex color (e.g. name:#ff0000). The tmx wrapper performs the
# actual NAME:color parsing via _parse_session_value; this prompt only
# blocks genuinely-dangerous characters (shell meta-chars, etc.).
# Reject in this order: length, then character set.
session_name_len=${#session_name}
if [ "$session_name_len" -lt 1 ] || [ "$session_name_len" -gt 80 ]; then
    printf '[tmx] invalid session name %s (length %s); allowed: [A-Za-z0-9_.-:#]{1,80}\n' "'$session_name'" "$session_name_len" >&2
    return 1 2>/dev/null || exit 1
fi

# Character-class check: reject if any char is OUTSIDE the allowed set.
# We use `case` with a glob that matches a string containing at least one
# disallowed char. POSIX `case` glob `*[!...]*` = "contains anything not in set".
# NOTE: '#' is placed between '_' and '.' to AVOID a backwards POSIX range
# ('.' > '#' in ASCII, so '.-#' would be an invalid range on some shells).
# The POSIX-safe order is: A-Z a-z 0-9 _ # . : with '-' literal at the end.
case "$session_name" in
    *[!A-Za-z0-9_#.:-]*)
        printf '[tmx] invalid session name %s; allowed: [A-Za-z0-9_.-#:]{1,80}\n' "'$session_name'" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

# §1 mandate (2026-07-05): a typed name ALWAYS creates a brand-new session
# — the real name is the typed name plus a random 4-digit suffix, so it
# can never collide with (or be confused for) a previous same-named
# session. TMX_EXACT_NAME=1 opts out (scripts/tests that need a
# deterministic exact name set this). No attach-first probe is needed
# here any more — a freshly-suffixed name is always unique, so `tmx new`
# is called directly.
if [ -n "${TMX_EXACT_NAME:-}" ]; then
    real_name="$session_name"
else
    _suffix=$(awk 'BEGIN{srand(); printf "%04d", int(rand()*10000)}')
    real_name="${session_name}-${_suffix}"
fi
exec sh -c 'exec tmx new -s "$1"' tmx-shell-init "$real_name"
